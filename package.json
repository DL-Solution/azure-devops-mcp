{
  "name": "@azure-devops/mcp",
  "version": "3.0.0",
  "mcpName": "microsoft.com/azure-devops",
  "description": "MCP server for interacting with Azure DevOps",
  "license": "MIT",
  "author": "Microsoft Corporation",
  "homepage": "https://github.com/microsoft/azure-devops-mcp",
  "bugs": "https://github.com/microsoft/azure-devops-mcp/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/azure-devops-mcp.git"
  },
  "type": "module",
  "bin": {
    "mcp-server-azuredevops": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "preinstall": "npm config set registry https://registry.npmjs.org/",
    "prebuild": "node -p \"'export const packageVersion = ' + JSON.stringify(require('./package.json').version) + ';\\n'\" > src/version.ts && prettier --write src/version.ts",
    "validate-tools": "tsc --noEmit && node scripts/build-validate-tools.js",
    "build": "tsc && shx chmod +x dist/*.js",
    "prepare": "npm run build && husky",
    "watch": "tsc --watch",
    "inspect": "ALLOWED_ORIGINS=http://127.0.0.1:6274 npx @modelcontextprotocol/inspector@0.21.0 node dist/index.js",
    "start": "node dist/index.js",
    "eslint": "eslint",
    "eslint-fix": "eslint --fix",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "toolset": "node scripts/generate-toolset.mjs",
    "toolset-check": "node scripts/generate-toolset.mjs --check",
    "api-coverage": "node scripts/api-coverage.mjs",
    "clean": "shx rm -rf dist",
    "test": "jest",
    "test:ci": "jest --coverage"
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.2",
    "@azure/identity": "^4.13.3",
    "@azure/logger": "^1.4.0",
    "@azure/msal-node": "^5.6.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "azure-devops-node-api": "^15.1.2",
    "express": "^5.2.1",
    "jose": "^6.2.3",
    "open": "^10.2.0",
    "winston": "^3.18.3",
    "yargs": "^18.0.0",
    "zod": "^3.25.63"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-header": "^3.1.1",
    "glob": "^13.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.2",
    "jest-extended": "^7.0.0",
    "lint-staged": "^17.0.0",
    "prettier": "3.9.5",
    "shx": "^0.4.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "lint-staged": {
    "**/*.(js|ts|jsx|tsx|json|css|md)": [
      "prettier --write"
    ],
    "**/*.(js|ts)": [
      "eslint --fix"
    ]
  }
}
